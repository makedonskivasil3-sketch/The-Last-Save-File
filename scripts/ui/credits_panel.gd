class_name CreditsPanel
extends VBoxContainer
## The title screen's CREDITS: who made it, the licence, and the Godot
## Engine's licence and third-party notices, read from the engine itself so
## they always match the version in the build (required by Godot's MIT
## licence and its components' licences).

signal closed

const AUTHOR := "makedonskivasil3-sketch"
const YEAR := 2026

var _back: Button
var _scroll: ScrollContainer


func _ready() -> void:
	add_theme_constant_override("separation", 4)
	UiStyle.heading(self, "CREDITS", UiStyle.TEXT, 16)
	_scroll = ScrollContainer.new()
	_scroll.custom_minimum_size = Vector2(0, 230)
	_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	add_child(_scroll)
	var body := VBoxContainer.new()
	body.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	body.add_theme_constant_override("separation", 3)
	_scroll.add_child(body)
	for block in credits():
		_section(body, block[0], block[1])
	_back = UiStyle.button(self, "Back", func() -> void: closed.emit(), "ui_back")


## [heading, text] blocks, in order: the game, then Godot and its components.
static func credits() -> Array:
	var out: Array = [
		["THE LAST SAVE FILE", "by %s" % AUTHOR],
		["MADE IN CODE", "Every image, sound and piece of music in this game is generated by its own code. There is no outside artwork, audio or recording. The only outside assets are two fonts, below."],
		["LICENCE", "© %d %s. All rights reserved." % [YEAR, AUTHOR]],
		["FONT: INTER", "Inter, by The Inter Project Authors (github.com/rsms/inter), used for the world and the interface. Subset for size.\n\n" + _file_text("res://assets/fonts/OFL-Inter.txt")],
		["FONT: DEJAVU SANS MONO", "DejaVu Sans Mono, used for the owner's system text. Subset for size. DejaVu changes are in the public domain; Bitstream Vera licence:\n\n" + _file_text("res://assets/fonts/LICENSE-DejaVu.txt")],
		["GODOT ENGINE", "This game uses the Godot Engine (godotengine.org), available under the following licence:\n\n" + Engine.get_license_text()],
	]
	# Every third-party component compiled into the engine, and its licence.
	var parts: Array[String] = []
	for c in Engine.get_copyright_info():
		for part in c.get("parts", []):
			var who: String = "\n".join(PackedStringArray(part.get("copyright", [])))
			parts.append("%s\n%s\nLicence: %s" % [c.get("name", ""), who, part.get("license", "")])
	out.append(["THIRD-PARTY COMPONENTS IN GODOT", "\n\n".join(parts)])
	var licences: Dictionary = Engine.get_license_info()
	for name in licences:
		out.append(["LICENCE: %s" % name, str(licences[name])])
	return out


static func _file_text(path: String) -> String:
	var text := FileAccess.get_file_as_string(path)
	return text if text != "" else "(licence file missing from this build: %s)" % path


func _section(parent: Control, title: String, text: String) -> void:
	var gap := Control.new()
	gap.custom_minimum_size.y = 4
	parent.add_child(gap)
	UiStyle.heading(parent, title, UiStyle.OWNER, 12)
	var l := UiStyle.note(parent, text, UiStyle.TEXT)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT


## Up/down (stick, d-pad or keys) scrolls: Back is the only button.
func _process(delta: float) -> void:
	if not is_visible_in_tree():
		return
	var dir := Input.get_axis("move_up", "move_down")
	if absf(dir) > 0.2:
		_scroll.scroll_vertical += int(dir * 420.0 * delta)


func _unhandled_input(event: InputEvent) -> void:
	if is_visible_in_tree() and (event.is_action_pressed("ui_cancel") or event.is_action_pressed("pause")):
		get_viewport().set_input_as_handled()
		closed.emit()


func focus_first() -> void:
	_back.grab_focus()
