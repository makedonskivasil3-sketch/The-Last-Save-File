extends "res://tests/test_case.gd"
## Movement variants A / B / C (MoveFeel) measured with the same scripted
## input in the game's real loop (physics at 60 Hz). Numbers, not a
## preference: which feels better needs players (docs/PLAYTEST_PLAN.md).
## Writes docs/review/movement/VARIANTS.md when --write-results is given.
##
##   $GODOT --headless --path . -s res://tests/run_tests.gd -- --test-mode \
##       --tour --filter=tour_move_variants [--write-results]

var _rows := []


func physics(n: int) -> void:
	for i in n:
		await tree.physics_frame


func _press(action: String, strength := 1.0) -> void:
	Input.action_press(action, strength)


func _release_all() -> void:
	for a in ["move_left", "move_right", "move_up", "move_down"]:
		Input.action_release(a)


func _measure(w: World, v: String) -> Dictionary:
	MoveFeel.variant = v
	var p: Player = w.player
	var out := {"variant": v}
	_release_all()
	await physics(6)
	# 1. Response: physics ticks from the press until she has travelled 0.5 px,
	#    and until the figure shows walking.
	p.global_position = Vector2(200, 200)
	await physics(3)
	var start := p.global_position
	_press("move_right")
	var moved_at := -1
	var shown_at := -1
	for i in 30:
		await physics(1)
		if moved_at < 0 and p.global_position.distance_to(start) > 0.5:
			moved_at = i + 1
		if shown_at < 0 and p._sprite.moving:
			shown_at = i + 1
	out["response_ms"] = moved_at * 1000.0 / 60.0
	out["shown_ms"] = shown_at * 1000.0 / 60.0
	# 2. Stopping distance after release at full speed.
	var at_release := p.global_position
	_release_all()
	await physics(30)
	out["stop_px"] = p.global_position.distance_to(at_release)
	# 3. A one-tick tap: how far does it carry?
	var before_tap := p.global_position
	_press("move_left")
	await physics(1)
	_release_all()
	await physics(30)
	out["tap_px"] = p.global_position.distance_to(before_tap)
	# 4. Approaching the save point: release the moment the prompt appears,
	#    then see how far past that spot she ends, and whether it stays focused.
	var sp: Vector2 = ArinsRoom.SAVE_POS + Vector2(0, 14)
	p.global_position = sp + Vector2(-70, 0)
	await physics(4)
	_press("move_right")
	var released := Vector2.INF
	for i in 120:
		await physics(1)
		if w._focused is SavePoint:
			released = p.global_position
			break
	_release_all()
	await physics(30)
	out["approach_overshoot_px"] = p.global_position.distance_to(released) if released != Vector2.INF else -1.0
	out["still_focused"] = w._focused is SavePoint
	# 5. Foot slide over 1 s: distance travelled minus strides drawn x STRIDE.
	for strength in [1.0, 0.5]:
		p.global_position = Vector2(150, 150)
		await physics(4)
		var w0: float = p._sprite._walk
		var from := p.global_position
		_press("move_right", strength)
		await physics(60)
		var travelled := p.global_position.distance_to(from)
		var drawn: float = (p._sprite._walk - w0) * PixelCharacter.STRIDE
		out["slide_%d" % int(strength * 100)] = absf(travelled - drawn)
		_release_all()
		await physics(20)
	# 6. Facing flips under a ±4° wobble about 45° for 1 s.
	var flips := 0
	var last: Vector2 = p._sprite.facing
	for i in 60:
		var a := deg_to_rad(45.0 + (4.0 if i % 2 == 0 else -4.0))
		_release_all()
		_press("move_right", cos(a))
		_press("move_down", sin(a))
		await physics(1)
		if p._sprite.facing != last:
			flips += 1
			last = p._sprite.facing
	_release_all()
	out["facing_flips"] = flips
	await physics(10)
	return out


func test_variants_in_the_room() -> void:
	var w := await start_session()
	w.director.paused = true
	await wait(0.5)
	for v in ["a", "b", "c"]:
		_rows.append(await _measure(w, v))
	MoveFeel.variant = ""
	var lines := ["| Variant | Visible motion after press | Walking shown | Stop distance | One-tick tap carries | Past the prompt point (release on prompt) | Still focused | Foot slide, full / half stick, 1 s | Facing flips (±4° at 45°, 1 s) |",
		"|---|---|---|---|---|---|---|---|---|"]
	for r in _rows:
		lines.append("| %s | %.0f ms | %.0f ms | %.2f px | %.2f px | %.2f px | %s | %.2f / %.2f px | %d |" % [r.variant.to_upper(), r.response_ms, r.shown_ms,
			r.stop_px, r.tap_px, r.approach_overshoot_px, "yes" if r.still_focused else "**no**", r.slide_100, r.slide_50, r.facing_flips])
	for l in lines:
		print(l)
	if "--write-results" in OS.get_cmdline_user_args():
		var f := FileAccess.open("res://docs/review/movement/VARIANTS.md", FileAccess.WRITE)
		f.store_string("# Movement variants: measured\n\nGenerated by `tests/tour_move_variants.gd`: the game's real loop, physics at 60 Hz, scripted input, headless. **Numbers only.** Which variant players prefer is unmeasured (`docs/PLAYTEST_PLAN.md`, session A).\n\n- **A:** immediate response, restrained presentation (no lean, squeeze or settle).\n- **B:** slightly weighted (%.2f s to full speed, %.2f s to stop).\n- **C:** current, the default.\n\nTry one in a build with `-- --move=a|b|c`, or `?move=a|b|c` on the web.\n\n" % [MoveFeel.TO_FULL, MoveFeel.TO_STOP] + "\n".join(lines) + "\n")
	check(_rows.size() == 3, "three variants measured")
